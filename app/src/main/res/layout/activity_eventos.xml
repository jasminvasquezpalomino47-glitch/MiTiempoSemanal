<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8F9FA">

    <!-- TÍTULO DE LA PANTALLA CON ESPACIO SUPERIOR PARA EVITAR LA CÁMARA/NOTIFICACIONES -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱️ Registro de Eventos"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1C1B1F"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp" />

    <!-- SECCIÓN DE BÚSQUEDA Y CREACIÓN CON MEJOR ESPACIADO -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="#E0E0E0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Seleccionar o Buscar Tarea"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1C1B1F"
                android:layout_marginBottom="12dp" />

            <!-- CAMPO DE BÚSQUEDA MÁS ESPACIOSO -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                android:hint="Escribe el nombre de la tarea...">

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteTask"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:completionThreshold="1"
                    android:inputType="textAutoComplete"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CATEGORÍA ASOCIADA DESTACADA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="#F3EDF7"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvCategoriaAsociada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Categoría: -"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#49454F" />
            </com.google.android.material.card.MaterialCardView>

            <!-- TIEMPO EN CURSO EN TIEMPO REAL -->
            <TextView
                android:id="@+id/tvTiempoEnCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="⏱️ Tiempo transcurrido: 00:00:00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#6750A4"
                android:visibility="gone"
                android:gravity="center" />

            <!-- BOTONES DE INICIAR Y FINALIZAR MÁS ALTOS Y CÓMODOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIniciarEvento"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="▶ Iniciar"
                    android:textSize="15sp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinalizarEvento"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="⏹ Finalizar"
                    android:textSize="15sp"
                    android:enabled="false"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- LISTA DE HISTORIAL -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📋 Historial de Eventos"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1C1B1F"
        android:layout_marginBottom="12dp" />

    <ListView
        android:id="@+id/lvEventos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp" />

</LinearLayout>