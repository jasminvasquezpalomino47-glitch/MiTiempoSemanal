<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📈 Reportes Semanales Históricos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <!-- SPINNER DE SEMANAS CON REPORTES -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E0E0E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Seleccionar Semana"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1C1B1F"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spnSemanasReporte"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:paddingStart="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- MENSAJE DE "AÚN NO HAY REPORTES" -->
        <TextView
            android:id="@+id/tvSinReportes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aún no hay reportes"
            android:textSize="16sp"
            android:textColor="#49454F"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />

        <!-- PANEL DE PORCENTAJES DE LA SEMANA SELECCIONADA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResumenReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E0E0E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Desglose por Categoría (168 Horas)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1C1B1F"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layoutReporteCategorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LISTA DE EVENTOS DE ESA SEMANA -->
        <TextView
            android:id="@+id/tvTituloEventosSemana"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Eventos de la Semana"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1C1B1F"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutEventosSemana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
